# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Server
PORT=4000
NODE_ENV=production
# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=https://your-frontend-domain.com

# Auth (single-user app)
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credential encryption (AES-256-GCM key, 32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# SQLite database file location
DB_PATH=./data/flowbox.sqlite

# Public base URL of THIS backend, used to build webhook URLs shown in the UI
PUBLIC_BASE_URL=https://your-backend-domain.com

# YouTube OAuth 2.0 Credentials (for YouTube Shorts publishing)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized redirect URI: http://localhost:4000/auth/youtube/callback (or your PUBLIC_BASE_URL + /auth/youtube/callback)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
